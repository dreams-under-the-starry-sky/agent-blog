<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blog.mapper.ArticleContentMapper">
    <select id="selectByArticleId" resultType="com.blog.entity.ArticleContent">
        SELECT id, article_id, content FROM blog_article_content WHERE article_id = #{articleId} LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO blog_article_content (article_id, content) VALUES (#{articleId}, #{content})
    </insert>

    <update id="updateByArticleId">
        UPDATE blog_article_content SET content = #{content} WHERE article_id = #{articleId}
    </update>

    <delete id="deleteByArticleId">
        DELETE FROM blog_article_content WHERE article_id = #{articleId}
    </delete>
</mapper>
